<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.smartfarm.ui.home.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_navigation_home_to_dailyInformationsFragment"
            app:destination="@id/navigation_dailyInformationsFragment" />
    </fragment>

    <fragment
        android:id="@+id/navigation_dashboard"
        android:name="com.example.smartfarm.ui.dashboard.DashboardFragment"
        android:label="@string/title_dashboard"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/navigation_notifications"
        android:name="com.example.smartfarm.ui.notifications.NotificationsFragment"
        android:label="@string/title_notifications"
        tools:layout="@layout/fragment_notifications" />

    <fragment
        android:id="@+id/navigation_dailyInformationsFragment"
        android:name="com.example.smartfarm.ui.daily_informations.DailyInformationsFragment"
        android:label="DailyInformationsFragment"
        tools:layout="@layout/fragment_daily_informations">
        <action
            android:id="@+id/action_navigation_dailyInformationsFragment_to_dailyInputFragment"
            app:destination="@id/dailyInputFragment" />
    </fragment>
    <fragment
        android:id="@+id/dailyInputFragment"
        android:name="com.example.smartfarm.ui.daily_informations.input_daily.DailyInputFragment"
        android:label="fragment_daily_input"
        tools:layout="@layout/fragment_daily_input" />

</navigation>