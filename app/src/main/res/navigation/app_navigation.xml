<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/app_navigation"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.smartfarm.ui.auth.RegisterFragment"
        android:label="RegisterFragment"
        tools:layout="@layout/fragment_register" >

        <action
            android:id="@+id/action_registerFragment_to_home_navigation"
            app:destination="@id/mobile_navigation"
            app:popUpTo="@id/registerFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.smartfarm.ui.auth.LoginFragment"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login" >
<!--        <action-->
<!--            android:id="@+id/action_loginFragment_to_forgotPasswordFragment"-->
<!--            app:destination="@id/forgotPasswordFragment" />-->
        <action
            android:id="@+id/action_loginFragment_to_home_navigation"
            app:destination="@id/mobile_navigation" />
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
    </fragment>

    <include app:graph="@navigation/mobile_navigation" />
</navigation>