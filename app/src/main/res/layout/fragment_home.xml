<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefreshLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="?attr/actionBarSize"
    tools:context=".ui.home.HomeFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvCoopsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:text="Selamat Datang,"
            android:includeFontPadding="false"
            android:textSize="14sp"
            android:textColor="@color/black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnAddCoop"/>

        <TextView
            android:id="@+id/tvUserName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:text="Username"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/btnAddCoop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvCoopsTitle" />

        <Button
            android:id="@+id/btnAddCoop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:drawableStart="@drawable/ic_baseline_add_24"
            android:text="Tambah Kandang"
            android:textAllCaps="false"
            android:textColor="@color/black"
            app:layout_constraintBottom_toBottomOf="@id/tvUserName"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvCoopsTitle" />

        <include
            android:id="@+id/included_sensor_kandang"
            layout="@layout/item_floor_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvUserName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <LinearLayout
            android:id="@+id/predictionEmptyRoot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintTop_toBottomOf="@id/included_sensor_kandang"
            app:layout_constraintBottom_toTopOf="@id/included_data_harian"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Top divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E6EAF0" />

            <!-- Content wrapper -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:gravity="center_horizontal">

                <!-- Title Hasil Prediksi -->
                <TextView
                    android:id="@+id/tvPredTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hasil Prediksi"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1F2A37"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/predictionChipContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_prediction_container"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp">

                    <!-- Row: chip + time -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Left pill Normal -->
                        <TextView
                            android:id="@+id/tvPredStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_prediction_chip"
                            android:paddingHorizontal="18dp"
                            android:paddingVertical="8dp"
                            android:text="Normal"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <!-- Spacer -->
                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <!-- Right time text -->
                        <TextView
                            android:id="@+id/tvPredTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="13:45"
                            android:textColor="#111827"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <!-- Small text at bottom (inside the same box) -->
                    <TextView
                        android:id="@+id/tvPredSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Informasi harian tidak ditemukan."
                        android:textColor="#4B5563"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Bottom divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E6EAF0" />
        </LinearLayout>


        <include
            android:id="@+id/included_data_harian"
            layout="@layout/item_daily_data"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/predictionEmptyRoot"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
