<!-- res/layout/item_notification.xml -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="8dp"
    app:cardUseCompatPadding="false"
    app:cardElevation="0dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:padding="12dp">

        <!-- Left red icon -->
        <ImageView
            android:id="@+id/icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            app:tint="@android:color/darker_gray"
            android:background="@drawable/bg_circle_red"
            android:padding="2dp"
            android:contentDescription="@string/app_name"/>

        <!-- Title (bold cage, bold abnormal) -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/icon"
            android:layout_marginStart="12dp"
            android:textColor="@color/black"
            android:text="Nama Kandang"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="2"/>

        <!-- Title (bold cage, bold abnormal) -->
        <TextView
            android:id="@+id/tvTitle2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@id/tvTitle"
            android:layout_toEndOf="@id/tvTitle"
            android:text=" diprediksi "
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="normal"/>

        <TextView
            android:id="@+id/tvTitlePrediction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@id/tvTitle"
            android:layout_toEndOf="@id/tvTitle2"
            android:text="Status"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <!-- Date -->
        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvTitle"
            android:layout_toEndOf="@id/icon"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:textColor="@color/gray_600"
            android:textSize="12sp"
            android:text="12 Okt 2025, 13:45"/>

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
