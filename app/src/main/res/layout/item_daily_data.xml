<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Title -->
        <TextView
            android:id="@+id/tv_text_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Informasi Harian"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <!-- Divider -->
        <View
            android:id="@+id/dividerTop"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tv_text_header"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Icons row 1 -->
        <LinearLayout
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@color/color_15"
            android:id="@+id/rowSensors"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/dividerTop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:textColor="@color/color_4"
                android:id="@+id/tvTemp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_outline_pulse_alert_24"
                android:drawablePadding="4dp"
                android:text="-"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:textColor="@color/color_4"
                android:id="@+id/tvAmmonia"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_outline_temp_preferences_eco_24"
                android:drawablePadding="4dp"
                android:text="-"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:textColor="@color/color_4"
                android:id="@+id/tvHumidity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_baseline_water_drop_24"
                android:text="-"
                android:textStyle="bold"

                android:gravity="center" />
        </LinearLayout>

        <LinearLayout
            android:paddingBottom="8dp"
            android:background="@color/color_15"
            android:id="@+id/rowSensorsBelow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rowSensors">

            <TextView
                android:textColor="@color/color_4"
                android:id="@+id/tvTempDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawablePadding="4dp"
                android:gravity="center"
                android:text="Ayam mati" />

            <TextView
                android:textColor="@color/color_4"
                android:id="@+id/tvHumidityDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawablePadding="4dp"
                android:gravity="center"
                android:text="Pakan" />

            <TextView
                android:textColor="@color/color_4"
                android:id="@+id/tvHSIDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Minum" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:id="@+id/dividerBottom"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/rowSensorsBelow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Icons row 2 -->
        <!--        <LinearLayout-->
        <!--            android:id="@+id/rowDevices"-->
        <!--            android:layout_width="0dp"-->
        <!--            android:layout_height="wrap_content"-->
        <!--            android:orientation="horizontal"-->
        <!--            android:gravity="center"-->
        <!--            android:layout_marginTop="8dp"-->
        <!--            app:layout_constraintTop_toBottomOf="@id/dividerBottom"-->
        <!--            app:layout_constraintStart_toStartOf="parent"-->
        <!--            app:layout_constraintEnd_toEndOf="parent">-->

        <!--            <TextView-->
        <!--                android:id="@+id/tvFan"-->
        <!--                android:layout_width="0dp"-->
        <!--                android:layout_height="wrap_content"-->
        <!--                android:layout_weight="1"-->
        <!--                android:drawableStart="@drawable/ic_outline_pulse_alert_24"-->
        <!--                android:drawablePadding="4dp"-->
        <!--                android:text="0"-->
        <!--                android:gravity="center_vertical|left" />-->

        <!--            <TextView-->
        <!--                android:id="@+id/tvCooler"-->
        <!--                android:layout_width="0dp"-->
        <!--                android:layout_height="wrap_content"-->
        <!--                android:layout_weight="1"-->
        <!--                android:drawableStart="@drawable/ic_outline_temp_preferences_eco_24"-->
        <!--                android:drawablePadding="4dp"-->
        <!--                android:text="Off"-->
        <!--                android:gravity="center_vertical|left" />-->

        <!--            <TextView-->
        <!--                android:id="@+id/tvHeater"-->
        <!--                android:layout_width="0dp"-->
        <!--                android:layout_height="wrap_content"-->
        <!--                android:layout_weight="1"-->
        <!--                android:drawableStart="@drawable/ic_baseline_water_drop_24"-->
        <!--                android:drawablePadding="4dp"-->
        <!--                android:text="Off"-->
        <!--                android:gravity="center_vertical|left" />-->
        <!--        </LinearLayout>-->

        <!-- Enter button -->
        <Button
            android:id="@+id/btnEnterData"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Masukkan Data"
            android:backgroundTint="@color/button_gray"
            android:textColor="@android:color/white"
            app:cornerRadius="8dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/dividerBottom"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
