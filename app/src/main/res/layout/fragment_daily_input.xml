<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Header nama kandang -->
        <TextView
            android:id="@+id/tvNamaKandang"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Kandang Ayam A"
            android:textSize="20sp"
            android:textStyle="bold"

            android:textColor="@android:color/black"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:paddingBottom="12dp" />

        <!-- Tanggal -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTanggal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Tanggal"
            app:endIconMode="custom"
            app:layout_constraintTop_toBottomOf="@id/tvNamaKandang"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_black_white_rect"
                android:focusable="false"
                android:inputType="date" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Jumlah Ayam Mati -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAyamMati"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Jumlah Ayam Mati"
            app:layout_constraintTop_toBottomOf="@id/tilTanggal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAyamMati"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_black_white_rect"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Bobot Ayam -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilBobot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Bobot Ayam (kg)"
            app:layout_constraintTop_toBottomOf="@id/tilAyamMati"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBobot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_black_white_rect"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Pakan -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPakan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Pakan (kg)"
            app:layout_constraintTop_toBottomOf="@id/tilBobot"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPakan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_black_white_rect"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Minum -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilMinum"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Minum (liter)"
            app:layout_constraintTop_toBottomOf="@id/tilPakan"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMinum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_black_white_rect"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Catatan -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCatatan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Catatan (opsional)"
            app:layout_constraintTop_toBottomOf="@id/tilMinum"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCatatan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:background="@drawable/bg_black_white_rect"
                android:lines="3"
                android:maxLines="5" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Tombol Submit -->
        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Simpan Data"
            android:backgroundTint="@color/button_gray"
            android:textColor="@android:color/white"
            app:cornerRadius="8dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/tilCatatan"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
